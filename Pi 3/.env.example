MAC_SERVER_URL=https://your-mac.tailnet.ts.net
SERVER_TOKEN=replace-me

# MAX98357A ALSA playback device. Use default when it is the default card.
# Fallback playback device (phát qua loa khi tai nghe Bluetooth chưa kết nối).
ONBOARD_PLAYBACK_DEVICE=default

BLUETOOTH_DEVICE_MAC=04:60:61:EF:78:22
# Runtime MP3 playback uses A2DP derived from BLUETOOTH_DEVICE_MAC.
# Phản hồi ưu tiên phát qua tai nghe A2DP; nếu không kết nối được thì phát loa MAX.

# Mic USB rời để thu giọng. Cập nhật theo tên thiết bị ALSA (chạy `arecord -l`).
# MIC_DEVICE thường là card name, ví dụ: "plughw:1,0", "default", hoặc tên card USB.
MIC_DEVICE=default
# Sample rate thu mic USB (đã test ổn định ở 16 kHz).
MIC_SAMPLE_RATE=16000

SILENCE_SECONDS=2
SILENCE_RMS=500
MAX_RECORD_SECONDS=30
# Timeout HTTP tách riêng theo endpoint: /stt nhanh, /command có thể lâu (Gemini + TTS).
STT_TIMEOUT_SECONDS=20
COMMAND_TIMEOUT_SECONDS=60
HTTP_RETRIES=2
CPU_IDLE_PERCENT=80
RAM_AVAILABLE_PERCENT=15

# GY25 (MPU6050, UART angle mode). Để trống = tắt cảm biến.
# Trên Pi Zero 2 W: /dev/serial0 (bật UART trong /boot/firmware/config.txt).
# Nhớ gán nối: GY25 TX -> Pi RX (GPIO15), GY25 RX -> Pi TX (GPIO14), chung GND.
GY25_DEVICE=/dev/serial0
GY25_BAUD=115200

# GY63 (MS5611-01BA03) qua I2C. Bật MS5611_ENABLED=true khi đã gắn.
# Trên Pi: bus 1 (SCL GPIO3, SDA GPIO2), addr mặc định 0x76.
MS5611_BUS=1
MS5611_ADDR=0x76
MS5611_ENABLED=false