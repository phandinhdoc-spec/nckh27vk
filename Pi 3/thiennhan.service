[Unit]
Description=Thien Nhan Pi voice and camera client
Wants=network-online.target
Requires=bluetooth.service bluealsa.service
After=network-online.target bluetooth.service bluealsa.service tailscaled.service

[Service]
Type=simple
User=thiennhan
Group=thiennhan
WorkingDirectory=/opt/thiennhan
EnvironmentFile=/opt/thiennhan/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/thiennhan/app.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/thiennhan/history

[Install]
WantedBy=multi-user.target
